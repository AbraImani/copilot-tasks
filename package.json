{
  "name": "copilot-tasks",
  "version": "1.0.0",
  "description": "Voice call assistant for GitHub Copilot CLI - enables voice conversations between coding agents and users",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "electron .",
    "dev:packaged": "npm run build:mac && open build/electron/mac-arm64/Copilot\\ Tasks.app",
    "test:call": "node test-call.js",
    "build": "vite build",
    "build:mac": "electron-builder --mac --dir",
    "build:installer": "npm run build && electron-builder",
    "build:installer:win": "npm run build && electron-builder --win",
    "build:installer:mac": "npm run build && electron-builder --mac"
  },
  "build": {
    "appId": "com.github.copilot-tasks",
    "productName": "Copilot Tasks",
    "directories": {
      "output": "build/electron"
    },
    "files": [
      "src/main/**/*",
      "dist/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/tray-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "entitlements": "build-resources/entitlements.mac.plist",
      "entitlementsInherit": "build-resources/entitlements.mac.plist",
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "Copilot Tasks needs microphone access for voice calls with the coding agent."
      }
    }
  },
  "keywords": [
    "copilot",
    "voice",
    "eleven-labs",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.56.0",
    "@fluentui/react-icons": "^2.0.260",
    "better-sqlite3": "^11.6.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uuid": "^11.0.0",
    "ws": "^8.19.0"
  }
}
